@model MaterialIssueEditViewModel
@{
    ViewData["Title"] = "Tạo phiếu cấp phát";
    ViewData["Subtitle"] = "Cấp phát nguyên vật liệu cho lệnh sản xuất đã duyệt.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Tạo phiếu cấp phát</h2>
        <p class="page-subtitle">Phiếu lưu ở trạng thái Nháp và chưa trừ tồn kho.</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
    </div>
</div>

<form method="post" asp-action="Create" autocomplete="off" data-line-form>
    <input type="hidden" asp-for="ReturnOrderId" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-arrow-down-square"></i>Thông tin phiếu cấp phát</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu nháp</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
