@model BomEditViewModel
@{
    ViewData["Title"] = "Tạo định mức BOM";
    ViewData["Subtitle"] = "Khai báo thành phẩm và danh sách nguyên vật liệu tiêu hao cho một đơn vị sản phẩm.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Tạo định mức BOM</h2>
        <p class="page-subtitle">Định mức là cơ sở tính nhu cầu vật tư cho lệnh sản xuất.</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<form method="post" asp-action="Create" autocomplete="off" data-line-form>
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-diagram-3"></i>Thông tin định mức</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu định mức</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
