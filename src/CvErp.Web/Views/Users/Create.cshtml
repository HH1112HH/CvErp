@model UserCreateViewModel
@{
    ViewData["Title"] = "Thêm người dùng";
    ViewData["Subtitle"] = "Tạo tài khoản mới và gán vai trò nghiệp vụ.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Thêm người dùng</h2>
        <p class="page-subtitle">Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
    </div>
    <div class="toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a></div>
</div>

<form method="post" asp-action="Create" autocomplete="off">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-person-plus"></i>Thông tin tài khoản</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="UserName" class="form-label required"></label>
                <input asp-for="UserName" class="form-control" placeholder="VD: nhanvien.kho" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FullName" class="form-label required"></label>
                <input asp-for="FullName" class="form-control" placeholder="Họ và tên" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="email@congty.vn" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Password" class="form-label required"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Role" class="form-label required"></label>
                <select asp-for="Role" class="form-select">
                    <option value="">— Chọn vai trò —</option>
                    @foreach (var option in Model.RoleOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.Role ? "selected" : null)">@option.Text</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo người dùng</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
