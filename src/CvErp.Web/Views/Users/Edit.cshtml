@model UserEditViewModel
@{
    ViewData["Title"] = "Sửa người dùng";
    ViewData["Subtitle"] = $"Cập nhật tài khoản {Model.UserName} và vai trò.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Sửa người dùng <span class="strong-code">@Model.UserName</span></h2>
        <p class="page-subtitle">Đổi vai trò sẽ thay thế vai trò hiện tại.</p>
    </div>
    <div class="toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a></div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" autocomplete="off">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserName" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-person-gear"></i>Thông tin tài khoản</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tên đăng nhập</label>
                <div class="readonly-value">@Model.UserName</div>
            </div>
            <div class="col-md-4">
                <label asp-for="FullName" class="form-label required"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Role" class="form-label required"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var option in Model.RoleOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.Role ? "selected" : null)">@option.Text</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Để trống nếu không đổi" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
