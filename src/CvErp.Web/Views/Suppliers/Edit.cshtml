@model SupplierEditViewModel
@{
    ViewData["Title"] = "Sửa nhà cung cấp";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Sửa nhà cung cấp <span class="strong-code">@Model.Code</span></h2>
        <p class="page-subtitle">Cập nhật thông tin liên hệ và trạng thái hợp tác.</p>
    </div>
    <div class="toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a></div>
</div>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id" autocomplete="off">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-pencil-square"></i>Thông tin nhà cung cấp</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
