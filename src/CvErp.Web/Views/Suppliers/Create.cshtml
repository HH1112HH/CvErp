@model SupplierEditViewModel
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}
<div class="page-header">
    <div><h2 class="page-title">Thêm nhà cung cấp</h2><p class="page-subtitle">Thông tin liên hệ phục vụ phiếu nhập kho.</p></div>
    <div class="toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a></div>
</div>
<form method="post" asp-action="Create" autocomplete="off">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-truck"></i>Thông tin nhà cung cấp</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu nhà cung cấp</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
