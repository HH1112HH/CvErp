@model StockDocumentDetailsViewModel
@{
    var document = Model.Document;
    var typeLabel = UiText.DocTypeLabel(document.Type);
    ViewData["Title"] = $"{typeLabel} {document.DocumentNo}";
    ViewData["Subtitle"] = $"{UiText.Date(document.DocumentDate)} · {document.Warehouse?.Name}";
    var isAdmin = User.IsInRole(AppRoles.Administrator);
    var canCreate = isAdmin || User.IsInRole(AppRoles.Warehouse) || User.IsInRole(AppRoles.Purchasing);
    var canApprove = isAdmin || User.IsInRole(AppRoles.Manager);
    var canPost = isAdmin || User.IsInRole(AppRoles.Warehouse);
    var canCancel = isAdmin || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Warehouse) || User.IsInRole(AppRoles.Purchasing);
    var canEdit = document.Status == DocumentStatus.Draft && canCreate;
    var canSubmit = document.Status == DocumentStatus.Draft && canCreate;
    var canApproveNow = document.Status == DocumentStatus.Submitted && canApprove;
    var canPostNow = document.Status == DocumentStatus.Approved && canPost;
    var canCancelNow = document.Status is DocumentStatus.Draft or DocumentStatus.Submitted or DocumentStatus.Approved && canCancel;
    var totalQuantity = document.Lines.Sum(x => x.Quantity);
    string UserName(string? id) => id is not null && Model.UserNames.TryGetValue(id, out var name) ? name : "—";
}

<div class="page-header">
    <div>
        <h2 class="page-title">@typeLabel <span class="strong-code">@document.DocumentNo</span></h2>
        <p class="page-subtitle">@document.Lines.Count dòng vật tư · tổng giá trị @UiText.Money(document.TotalAmount) đ</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
        @if (canEdit)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@document.Id"><i class="bi bi-pencil me-1"></i>Sửa</a>
        }
        <button class="btn btn-outline-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-1"></i>In</button>
    </div>
</div>

<div class="doc-hero">
    <div>
        <div class="doc-number">
            @document.DocumentNo
            <span class="badge @UiText.StatusCss(document.Status) align-middle ms-1">@UiText.StatusLabel(document.Status)</span>
        </div>
        <div class="doc-meta">
            @typeLabel · ngày chứng từ @UiText.Date(document.DocumentDate) · tạo bởi @UserName(document.CreatedById)
        </div>
        <div class="mt-2 d-flex flex-wrap gap-2">
            <span class="badge text-bg-light"><i class="bi bi-buildings me-1"></i>@document.Warehouse?.Name</span>
            @if (document.DestinationWarehouse is not null)
            {
                <span class="badge text-bg-light"><i class="bi bi-arrow-right me-1"></i>@document.DestinationWarehouse.Name</span>
            }
            @if (document.Supplier is not null)
            {
                <span class="badge text-bg-light"><i class="bi bi-truck me-1"></i>@document.Supplier.Name</span>
            }
        </div>
    </div>
    <div class="text-end">
        <div class="text-muted-sm">Tổng giá trị chứng từ</div>
        <div class="doc-amount">@UiText.Money(document.TotalAmount) <small class="fs-6 text-muted">đ</small></div>
        <div class="text-muted-sm">@UiText.Qty(totalQuantity) đơn vị vật tư</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Chi tiết vật tư</span>
                <span class="text-muted-sm">@document.Lines.Count dòng</span>
            </div>
            <div class="table-responsive">
                <table class="table-erp">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Mã vật tư</th>
                            <th>Tên vật tư</th>
                            <th>ĐVT</th>
                            <th class="text-end">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (document.Lines.Count == 0)
                        {
                            <tr><td colspan="7"><div class="empty-state py-4"><i class="bi bi-inbox"></i><strong>Chứng từ chưa có dòng vật tư</strong></div></td></tr>
                        }
                        @{ var index = 0; }
                        @foreach (var line in document.Lines.OrderBy(x => x.Item?.Code))
                        {
                            index++;
                            <tr>
                                <td class="text-muted-sm">@index</td>
                                <td class="strong-code">@line.Item?.Code</td>
                                <td class="fw-semibold">@line.Item?.Name</td>
                                <td>@line.Item?.Unit</td>
                                <td class="num">@UiText.Qty(line.Quantity)</td>
                                <td class="num">@UiText.Money(line.UnitCost)</td>
                                <td class="num fw-semibold">@UiText.Money(line.Amount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-semibold">Tổng cộng</td>
                            <td class="num fw-semibold">@UiText.Qty(totalQuantity)</td>
                            <td></td>
                            <td class="num fw-bold text-brand">@UiText.Money(document.TotalAmount) đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(document.Note))
            {
                <div class="card-body border-top">
                    <div class="text-muted-sm"><i class="bi bi-chat-left-text me-1"></i>@document.Note</div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">Tiến trình chứng từ</div>
            <div class="card-body">
                <partial name="_Workflow" model="document.Status" />
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header">Xử lý chứng từ</div>
            <div class="card-body">
                @if (document.Status == DocumentStatus.Posted)
                {
                    <div class="alert alert-success d-flex gap-2 align-items-start mb-0">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>
                            <strong>Đã ghi sổ.</strong>
                            Tồn kho đã được cập nhật và chứng từ không thể sửa.
                        </div>
                    </div>
                }
                else if (document.Status == DocumentStatus.Cancelled)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Đã hủy.</strong>
                        @if (!string.IsNullOrWhiteSpace(document.CancelReason))
                        {
                            <div class="small mt-1">Lý do: @document.CancelReason</div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @if (canSubmit)
                        {
                            <form asp-action="Submit" asp-route-id="@document.Id" method="post" data-confirm="Trình duyệt chứng từ @document.DocumentNo?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-send me-1"></i>Trình duyệt
                                </button>
                            </form>
                        }
                        @if (canApproveNow)
                        {
                            <form asp-action="Approve" asp-route-id="@document.Id" method="post" data-confirm="Phê duyệt chứng từ @document.DocumentNo?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check2-circle me-1"></i>Phê duyệt
                                </button>
                            </form>
                        }
                        @if (canPostNow)
                        {
                            <form asp-action="Post" asp-route-id="@document.Id" method="post" data-confirm="Ghi sổ chứng từ @document.DocumentNo? Tồn kho sẽ được cập nhật ngay.">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-journal-check me-1"></i>Ghi sổ kho
                                </button>
                            </form>
                        }
                        @if (!canSubmit && !canApproveNow && !canPostNow)
                        {
                            <div class="text-muted-sm">
                                <i class="bi bi-hourglass-split me-1"></i>Chứng từ đang chờ bước xử lý tiếp theo.
                            </div>
                        }
                        @if (canCancelNow)
                        {
                            <button type="button" class="btn btn-light text-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="bi bi-x-octagon me-1"></i>Hủy chứng từ
                            </button>
                        }
                    </div>
                    <div class="text-muted-sm mt-3">
                        <i class="bi bi-shield-lock me-1"></i>
                        Ghi sổ chỉ thực hiện một lần. Hệ thống kiểm tra tồn kho và chống ghi trùng.
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Thông tin chứng từ</div>
            <div class="card-body">
                <div class="detail-item mb-3">
                    <label>Người tạo</label>
                    <div>@UserName(document.CreatedById)</div>
                    <div class="text-muted-sm">@UiText.DateTimeLocal(document.CreatedAt)</div>
                </div>
                <div class="detail-item mb-3">
                    <label>Người trình duyệt</label>
                    <div>@UserName(document.SubmittedById)</div>
                    <div class="text-muted-sm">@UiText.DateTimeLocal(document.SubmittedAt)</div>
                </div>
                <div class="detail-item mb-3">
                    <label>Người phê duyệt</label>
                    <div>@UserName(document.ApprovedById)</div>
                    <div class="text-muted-sm">@UiText.DateTimeLocal(document.ApprovedAt)</div>
                </div>
                <div class="detail-item mb-3">
                    <label>Người ghi sổ</label>
                    <div>@UserName(document.PostedById)</div>
                    <div class="text-muted-sm">@UiText.DateTimeLocal(document.PostedAt)</div>
                </div>
                @if (document.CancelledById is not null)
                {
                    <div class="detail-item">
                        <label>Người hủy</label>
                        <div>@UserName(document.CancelledById)</div>
                        <div class="text-muted-sm">@UiText.DateTimeLocal(document.CancelledAt)</div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="form-section-title mb-2"><i class="bi bi-lightbulb"></i>Quy tắc nghiệp vụ</div>
                <ul class="text-muted-sm mb-0 ps-3">
                    <li>Chỉ Quản trị viên hoặc Quản lý mới được phê duyệt chứng từ.</li>
                    <li>Chỉ chứng từ đã duyệt mới được ghi sổ.</li>
                    <li>Xuất kho vượt tồn sẽ bị chặn tại bước ghi sổ.</li>
                    <li>Chứng từ đã ghi sổ không thể sửa hoặc hủy.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (canCancelNow)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Cancel" asp-route-id="@document.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="cancelModalLabel">Hủy chứng từ @document.DocumentNo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted-sm">Chứng từ đã hủy sẽ không thể ghi sổ. Vui lòng nhập lý do để lưu nhật ký.</p>
                        <label class="form-label" for="cancelReason">Lý do hủy</label>
                        <textarea id="cancelReason" name="reason" class="form-control" rows="3" maxlength="500"
                                  placeholder="VD: Nhập sai số lượng, lập lại chứng từ..." required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-octagon me-1"></i>Xác nhận hủy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
