@model StockDocumentEditViewModel
@{
    ViewData["Title"] = "Sửa chứng từ kho";
    ViewData["Subtitle"] = $"Cập nhật {Model.DocumentNo}. Chỉ chứng từ nháp mới được chỉnh sửa.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Sửa chứng từ <span class="strong-code">@Model.DocumentNo</span></h2>
        <p class="page-subtitle">Thay đổi chi tiết vật tư trước khi trình duyệt.</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left me-1"></i>Chi tiết</a>
    </div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" autocomplete="off" data-line-form>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DocumentNo" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-pencil-square"></i>Thông tin chứng từ</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
        <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
