@model StockDocumentEditViewModel
@{
    var typeLabel = UiText.DocTypeLabel(Model.Type);
    ViewData["Title"] = $"Lập {typeLabel.ToLowerInvariant()}";
    ViewData["Subtitle"] = Model.Type switch
    {
        StockDocumentType.Receipt => "Ghi nhận vật tư nhập kho từ nhà cung cấp hoặc nhập khác.",
        StockDocumentType.Issue => "Xuất vật tư khỏi kho cho sản xuất hoặc mục đích nội bộ.",
        _ => "Chuyển vật tư giữa hai kho, ghi nhận đồng thời xuất và nhập."
    };
}
<div class="page-header">
    <div>
        <h2 class="page-title">Lập @typeLabel.ToLowerInvariant()</h2>
        <p class="page-subtitle">Chứng từ được lưu ở trạng thái Nháp và chưa ảnh hưởng tồn kho.</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
    </div>
</div>

<form method="post" asp-action="Create" autocomplete="off" data-line-form>
    <input type="hidden" asp-for="Type" />
    <div asp-validation-summary="All" class="alert alert-danger py-2 small validation-summary" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-receipt"></i>Thông tin chứng từ</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu nháp</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
        <span class="text-muted-sm ms-auto"><i class="bi bi-info-circle me-1"></i>Sau khi lưu, bạn có thể trình duyệt chứng từ.</span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
