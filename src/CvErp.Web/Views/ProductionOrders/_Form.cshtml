@model ProductionOrderCreateViewModel
<div class="row g-3">
    <div class="col-md-5">
        <label asp-for="FinishedGoodItemId" class="form-label required"></label>
        <select asp-for="FinishedGoodItemId" class="form-select" data-bom-product>
            <option value="0">— Chọn thành phẩm —</option>
            @foreach (var option in Model.ProductOptions)
            {
                <option value="@option.Value" selected="@(option.Value == Model.FinishedGoodItemId.ToString() ? "selected" : null)">@option.Text</option>
            }
        </select>
        <span asp-validation-for="FinishedGoodItemId" class="text-danger small"></span>
        <div class="form-text">Chỉ thành phẩm có BOM đang áp dụng mới tạo được lệnh.</div>
    </div>
    <div class="col-md-3">
        <label asp-for="PlannedQuantity" class="form-label required"></label>
        <input asp-for="PlannedQuantity" type="number" step="0.0001" min="0.0001" class="form-control" data-bom-quantity />
        <span asp-validation-for="PlannedQuantity" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="OutputWarehouseId" class="form-label required"></label>
        <select asp-for="OutputWarehouseId" class="form-select">
            <option value="0">— Chọn kho nhập thành phẩm —</option>
            @foreach (var option in Model.WarehouseOptions)
            {
                <option value="@option.Value" selected="@(option.Value == Model.OutputWarehouseId.ToString() ? "selected" : null)">@option.Text</option>
            }
        </select>
        <span asp-validation-for="OutputWarehouseId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="StartDate" class="form-label required"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DueDate" class="form-label required"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Note" class="form-label"></label>
        <input asp-for="Note" class="form-control" placeholder="Ghi chú kế hoạch sản xuất" />
        <span asp-validation-for="Note" class="text-danger small"></span>
    </div>
</div>

<div class="form-section mt-1" data-bom-preview data-bom-preview-url="@Url.Action("BomPreview", "ProductionOrders")">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="form-section-title mb-0"><i class="bi bi-diagram-3"></i>Nhu cầu vật tư dự kiến</div>
        <span class="badge text-bg-light" data-bom-status>Chọn thành phẩm để xem BOM</span>
    </div>
    <div class="table-responsive">
        <table class="table-erp">
            <thead>
                <tr>
                    <th>Mã NVL</th>
                    <th>Tên nguyên vật liệu</th>
                    <th>ĐVT</th>
                    <th class="text-end">Nhu cầu</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Giá trị</th>
                </tr>
            </thead>
            <tbody data-bom-body>
                <tr>
                    <td colspan="6">
                        <div class="empty-state py-4">
                            <i class="bi bi-diagram-3"></i>
                            <strong>Chưa có dữ liệu định mức</strong>
                            <p>Chọn thành phẩm và số lượng kế hoạch để xem nhu cầu vật tư.</p>
                        </div>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-end fw-semibold">Tổng chi phí NVL định mức</td>
                    <td class="num fw-bold text-brand" data-bom-total>0 đ</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
