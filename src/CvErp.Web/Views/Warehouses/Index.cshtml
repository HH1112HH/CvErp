@model WarehouseListViewModel
@{
    ViewData["Title"] = "Kho hàng";
    ViewData["Subtitle"] = "Nhiều kho, vị trí lưu trữ và giá trị tồn theo từng kho.";
    var canEdit = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Manager);
    var activeCount = Model.Warehouses.Count(x => x.IsActive);
}

<div class="page-header">
    <div>
        <h2 class="page-title">Danh mục kho</h2>
        <p class="page-subtitle">@Model.Warehouses.Count kho · @activeCount đang hoạt động</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-outline-primary" asp-controller="Stock" asp-action="Index">
            <i class="bi bi-boxes me-1"></i>Tồn kho theo kho
        </a>
        @if (canEdit)
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm kho</a>
        }
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="filter-grid">
        <div class="span-6">
            <label class="form-label" for="search">Tìm kiếm</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Mã, tên hoặc vị trí kho..." />
        </div>
        <div class="span-3">
            <label class="form-label" for="active">Trạng thái</label>
            <select id="active" name="active" class="form-select">
                <option value="">Tất cả</option>
                <option value="true" selected="@(Model.Active == true)">Đang hoạt động</option>
                <option value="false" selected="@(Model.Active == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="span-3 d-flex align-items-end gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Lọc</button>
            <a class="btn btn-light" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="row g-3">
    @if (Model.Warehouses.Count == 0)
    {
        <div class="col-12">
            <div class="card"><div class="empty-state"><i class="bi bi-buildings"></i><strong>Chưa có kho</strong><p>Thêm kho đầu tiên để bắt đầu quản lý tồn kho.</p></div></div>
        </div>
    }
    @foreach (var warehouse in Model.Warehouses)
    {
        Model.StockValues.TryGetValue(warehouse.Id, out var stockValue);
        Model.ItemCounts.TryGetValue(warehouse.Id, out var itemCount);
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="kpi-icon bg-soft-blue"><i class="bi bi-buildings"></i></div>
                        @if (warehouse.IsActive)
                        {
                            <span class="badge text-bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Ngừng</span>
                        }
                    </div>
                    <div class="strong-code">@warehouse.Code</div>
                    <h3 class="h6 fw-bold mb-1">@warehouse.Name</h3>
                    <div class="text-muted-sm mb-3"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(warehouse.Location) ? "Chưa cập nhật vị trí" : warehouse.Location)</div>
                    <div class="detail-grid" style="grid-template-columns:1fr 1fr;">
                        <div class="detail-item">
                            <label>Giá trị tồn</label>
                            <div class="big">@UiText.Money(stockValue) <small class="text-muted">đ</small></div>
                        </div>
                        <div class="detail-item">
                            <label>Số mã vật tư</label>
                            <div class="big">@itemCount</div>
                        </div>
                    </div>
                </div>
                <div class="card-body border-top pt-2 d-flex gap-2">
                    <a class="btn btn-light btn-sm flex-fill" asp-controller="Stock" asp-action="Index" asp-route-warehouseId="@warehouse.Id">
                        <i class="bi bi-boxes me-1"></i>Xem tồn
                    </a>
                    @if (canEdit)
                    {
                        <a class="btn btn-outline-primary btn-sm flex-fill" asp-action="Edit" asp-route-id="@warehouse.Id">
                            <i class="bi bi-pencil me-1"></i>Sửa
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>
