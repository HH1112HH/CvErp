@model WarehouseEditViewModel
@{
    ViewData["Title"] = "Thêm kho";
    ViewData["Subtitle"] = "Khai báo kho mới và vị trí lưu trữ.";
}
<div class="page-header">
    <div><h2 class="page-title">Thêm kho</h2></div>
    <div class="toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a></div>
</div>
<form method="post" asp-action="Create" autocomplete="off">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-buildings"></i>Thông tin kho</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu kho</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
