@model ItemEditViewModel
@{
    ViewData["Title"] = "Thêm vật tư";
    ViewData["Subtitle"] = "Khai báo mã vật tư mới cho kho hoặc thành phẩm cho sản xuất.";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Thêm vật tư</h2>
        <p class="page-subtitle">Mã vật tư là duy nhất trong toàn hệ thống.</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<form method="post" asp-action="Create" autocomplete="off">
    <div asp-validation-summary="All" class="alert alert-danger py-2 small d-none-if-empty" role="alert"></div>
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-box-seam"></i>Thông tin vật tư</div>
        <partial name="_Form" model="Model" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu vật tư</button>
        <a class="btn btn-light" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
