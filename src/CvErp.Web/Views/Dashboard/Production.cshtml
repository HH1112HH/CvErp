@model ProductionDashboardViewModel
@{
    ViewData["Title"] = "Dashboard sản xuất";
    ViewData["Subtitle"] = "Kế hoạch, sản lượng thực tế, tỷ lệ hoàn thành và chất lượng.";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Tiến độ sản xuất</h2>
        <p class="page-subtitle">Kỳ @UiText.Date(Model.From) – @UiText.Date(Model.To)</p>
    </div>
    <div class="toolbar">
        <a class="btn btn-outline-primary" asp-controller="ProductionOrders" asp-action="Index">
            <i class="bi bi-clipboard-data me-1"></i>Danh sách lệnh
        </a>
        <a class="btn btn-outline-primary" asp-controller="Reports" asp-action="Production">
            <i class="bi bi-file-earmark-bar-graph me-1"></i>Báo cáo sản xuất
        </a>
    </div>
</div>

<partial name="_DateRangeFilter" model="@(new DateRangeFilterModel { From = Model.From, To = Model.To, Action = "Production", Controller = "Dashboard", Label = "Kỳ phân tích" })" />

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon bg-soft-blue"><i class="bi bi-calendar-check"></i></div>
        <div>
            <div class="kpi-label">Sản lượng kế hoạch</div>
            <div class="kpi-value">@UiText.Qty(Model.Data.PlannedInPeriod)<small> SP</small></div>
            <div class="kpi-note">Theo hạn hoàn thành trong kỳ</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon bg-soft-teal"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="kpi-label">Sản lượng tốt</div>
            <div class="kpi-value">@UiText.Qty(Model.Data.ActualInPeriod)<small> SP</small></div>
            <div class="kpi-note">Đã nhập kho thành phẩm</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon bg-soft-violet"><i class="bi bi-speedometer2"></i></div>
        <div>
            <div class="kpi-label">Tỷ lệ hoàn thành</div>
            <div class="kpi-value">@UiText.Percent(Model.Data.CompletionRate)</div>
            <div class="kpi-note">Thực tế / kế hoạch</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon bg-soft-red"><i class="bi bi-exclamation-diamond"></i></div>
        <div>
            <div class="kpi-label">Tỷ lệ lỗi</div>
            <div class="kpi-value">@UiText.Percent(Model.Data.DefectRate)</div>
            <div class="kpi-note">@UiText.Qty(Model.Data.DefectInPeriod) sản phẩm lỗi</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-8">
        <div class="chart-card h-100">
            <div class="chart-title">Sản lượng theo tháng</div>
            <div class="chart-sub">So sánh kế hoạch, sản lượng tốt và lỗi</div>
            <div class="chart-box"><canvas id="outputChart"></canvas></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="chart-card h-100">
            <div class="chart-title">Trạng thái lệnh sản xuất</div>
            <div class="chart-sub">Toàn bộ lệnh trong hệ thống</div>
            <div class="chart-box"><canvas id="statusChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Lệnh sắp đến hạn</span>
                <span class="badge text-bg-warning">@Model.Data.InProgressCount đang sản xuất</span>
            </div>
            <div class="table-responsive">
                <table class="table-erp">
                    <thead>
                        <tr>
                            <th>Lệnh</th>
                            <th class="text-end">Kế hoạch</th>
                            <th>Hạn</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.UpcomingOrders.Count == 0)
                        {
                            <tr><td colspan="4"><div class="empty-state py-4"><i class="bi bi-clipboard-check"></i><strong>Không có lệnh sắp tới</strong></div></td></tr>
                        }
                        @foreach (var order in Model.Data.UpcomingOrders)
                        {
                            <tr>
                                <td>
                                    <a class="strong-code" asp-controller="ProductionOrders" asp-action="Details" asp-route-id="@order.Id">@order.OrderNo</a>
                                    <div class="text-muted-sm">@order.ProductName</div>
                                </td>
                                <td class="num">@UiText.Qty(order.PlannedQuantity)</td>
                                <td class="nowrap">@UiText.Date(order.DueDate)</td>
                                <td>@Html.Raw(UiText.Badge(UiText.ProductionStatusLabel(order.Status), UiText.ProductionStatusCss(order.Status)))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Lệnh hoàn thành gần đây</span>
                <span class="badge text-bg-success">@Model.Data.CompletedOrderCount trong kỳ</span>
            </div>
            <div class="table-responsive">
                <table class="table-erp">
                    <thead>
                        <tr>
                            <th>Lệnh</th>
                            <th class="text-end">Tốt</th>
                            <th class="text-end">Lỗi</th>
                            <th>Hoàn thành</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.RecentOrders.Count == 0)
                        {
                            <tr><td colspan="4"><div class="empty-state py-4"><i class="bi bi-inbox"></i><strong>Chưa có lệnh hoàn thành</strong></div></td></tr>
                        }
                        @foreach (var order in Model.Data.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <a class="strong-code" asp-controller="ProductionOrders" asp-action="Details" asp-route-id="@order.Id">@order.OrderNo</a>
                                    <div class="text-muted-sm">@order.ProductName</div>
                                </td>
                                <td class="num stock-positive">@UiText.Qty(order.ActualQuantity)</td>
                                <td class="num @(order.DefectQuantity > 0 ? "stock-zero" : "")">@UiText.Qty(order.DefectQuantity)</td>
                                <td class="text-muted-sm">@UiText.DateTimeLocal(order.CompletedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Cơ cấu trạng thái</div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var status in Model.Data.StatusCounts)
            {
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="summary-box h-100">
                        <div class="text-muted-sm">@UiText.ProductionStatusLabel(status.Status)</div>
                        <div class="fs-4 fw-bold">@status.Count</div>
                        <div>@Html.Raw(UiText.Badge(UiText.ProductionStatusLabel(status.Status), UiText.ProductionStatusCss(status.Status)))</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (function () {
            if (!window.Chart) return;

            const output = @Html.Raw(JsonSerializer.Serialize(new
            {
                labels = Model.Data.OutputByMonth.Select(x => x.Month).ToList(),
                planned = Model.Data.OutputByMonth.Select(x => x.Planned).ToList(),
                actual = Model.Data.OutputByMonth.Select(x => x.Actual).ToList(),
                defect = Model.Data.OutputByMonth.Select(x => x.Defect).ToList()
            }));

            new Chart(document.getElementById('outputChart'), {
                type: 'line',
                data: {
                    labels: output.labels,
                    datasets: [
                        { label: 'Kế hoạch', data: output.planned, borderColor: '#9db4c6', backgroundColor: 'rgba(157,180,198,.12)', borderDash: [5, 4], tension: .32, pointRadius: 2 },
                        { label: 'Tốt', data: output.actual, borderColor: '#146c8a', backgroundColor: 'rgba(20,108,138,.12)', tension: .32, pointRadius: 3, fill: true },
                        { label: 'Lỗi', data: output.defect, borderColor: '#c0392b', backgroundColor: 'rgba(192,57,43,.1)', tension: .32, pointRadius: 2 }
                    ]
                },
                options: erpCharts.lineOptions('')
            });

            const statuses = @Html.Raw(JsonSerializer.Serialize(new
            {
                labels = Model.Data.StatusCounts.Select(x => UiText.ProductionStatusLabel(x.Status)).ToList(),
                values = Model.Data.StatusCounts.Select(x => x.Count).ToList()
            }));

            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: statuses.labels,
                    datasets: [{ data: statuses.values, backgroundColor: erpCharts.palette, borderWidth: 2, borderColor: '#fff' }]
                },
                options: erpCharts.doughnutOptions('')
            });
        })();
    </script>
}
