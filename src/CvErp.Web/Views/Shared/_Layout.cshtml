<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0f2b46" />
    <meta name="description" content="Vinatex Phú Hưng ERP - Bản demo quản trị kho, nguyên vật liệu và sản xuất" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Vinatex Phú Hưng" />
    <title>@ViewData["Title"] · Vinatex Phú Hưng</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="~/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
    var primaryRole = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var roleLabel = UiText.RoleLabel(primaryRole);
    var isAdmin = User.IsInRole(AppRoles.Administrator);
    var isManager = User.IsInRole(AppRoles.Manager);
    var canApprove = isAdmin || isManager;
    var canViewVariance = isAdmin || isManager;
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Trim()[0].ToString().ToUpperInvariant();
    string NavClass(string controller, string? action = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionMatches = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerMatches && actionMatches ? "nav-link active" : "nav-link";
    }
}
<div class="app-shell">
    <aside class="sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
                <span class="brand-mark">VPH</span>
                <span class="brand-text">
                    <strong>Vinatex Phú Hưng</strong>
                    <small>ERP · Kho &amp; Sản xuất</small>
                </span>
            </a>
        </div>
        <nav class="sidebar-nav" aria-label="Điều hướng chính">
            <div class="nav-group">
                <div class="nav-heading">Tổng quan</div>
                <a class="@NavClass("Dashboard", "Index")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Tổng quan</span>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-heading">Danh mục</div>
                <a class="@NavClass("Items")" asp-controller="Items" asp-action="Index">
                    <i class="bi bi-box-seam"></i><span>Vật tư &amp; thành phẩm</span>
                </a>
                <a class="@NavClass("Warehouses")" asp-controller="Warehouses" asp-action="Index">
                    <i class="bi bi-buildings"></i><span>Kho hàng</span>
                </a>
                <a class="@NavClass("Suppliers")" asp-controller="Suppliers" asp-action="Index">
                    <i class="bi bi-truck"></i><span>Nhà cung cấp</span>
                </a>
                <a class="@NavClass("Boms")" asp-controller="Boms" asp-action="Index">
                    <i class="bi bi-diagram-3"></i><span>Định mức BOM</span>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-heading">Kho vận</div>
                <a class="@NavClass("StockDocuments")" asp-controller="StockDocuments" asp-action="Index">
                    <i class="bi bi-receipt-cutoff"></i><span>Chứng từ kho</span>
                </a>
                <a class="@NavClass("Stock")" asp-controller="Stock" asp-action="Index">
                    <i class="bi bi-boxes"></i><span>Tồn kho &amp; thẻ kho</span>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-heading">Sản xuất</div>
                <a class="@NavClass("ProductionOrders")" asp-controller="ProductionOrders" asp-action="Index">
                    <i class="bi bi-clipboard-data"></i><span>Lệnh sản xuất</span>
                </a>
                <a class="@NavClass("MaterialIssues")" asp-controller="MaterialIssues" asp-action="Index">
                    <i class="bi bi-arrow-down-square"></i><span>Cấp phát vật tư</span>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-heading">Phân tích</div>
                <a class="@NavClass("Dashboard", "Inventory")" asp-controller="Dashboard" asp-action="Inventory">
                    <i class="bi bi-graph-up"></i><span>Dashboard kho</span>
                </a>
                <a class="@NavClass("Dashboard", "Production")" asp-controller="Dashboard" asp-action="Production">
                    <i class="bi bi-bar-chart-line"></i><span>Dashboard sản xuất</span>
                </a>
                @if (canViewVariance)
                {
                    <a class="@NavClass("Dashboard", "Variance")" asp-controller="Dashboard" asp-action="Variance">
                        <i class="bi bi-currency-exchange"></i><span>Chênh lệch chi phí</span>
                    </a>
                }
                <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph"></i><span>Trung tâm báo cáo</span>
                </a>
            </div>
            @if (canApprove || isAdmin)
            {
                <div class="nav-group">
                    <div class="nav-heading">Hệ thống</div>
                    <a class="@NavClass("AuditLogs")" asp-controller="AuditLogs" asp-action="Index">
                        <i class="bi bi-shield-check"></i><span>Nhật ký thao tác</span>
                    </a>
                    @if (isAdmin)
                    {
                        <a class="@NavClass("Users")" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people"></i><span>Người dùng &amp; vai trò</span>
                        </a>
                    }
                </div>
            }
        </nav>
        <div class="sidebar-foot">
            <span class="demo-dot"></span>
            <div>
                <strong>Bản demo độc lập</strong>
                <small>Không phải hệ thống chính thức</small>
            </div>
        </div>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="btn btn-light btn-icon d-lg-none" type="button" id="sidebarToggle" aria-label="Mở menu">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="page-heading">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string subtitle && !string.IsNullOrWhiteSpace(subtitle))
                    {
                        <p>@subtitle</p>
                    }
                </div>
            </div>
            <div class="topbar-right">
                <button class="btn btn-outline-primary btn-sm install-btn d-none" id="btnInstallPwa" type="button">
                    <i class="bi bi-download me-1"></i>Cài đặt app
                </button>
                <div class="topbar-date d-none d-xl-flex">
                    <i class="bi bi-calendar3"></i>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="dropdown">
                    <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@initial</span>
                        <span class="user-meta">
                            <strong>@fullName</strong>
                            <small>@roleLabel</small>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li class="dropdown-header">@User.Identity?.Name</li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="app-content">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>© @DateTime.Now.Year Vinatex Phú Hưng · Bản demo độc lập, không phải hệ thống chính thức</span>
            <span class="text-muted d-none d-md-inline">ASP.NET Core 10 · EF Core · SQL Server · Bootstrap 5 · Chart.js</span>
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
